<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FixedPoint\Runtime\FixedPoint.csproj" />
    <ProjectReference Include="..\static-rollback-litenetlib\Runtime\Shenanicode.Rollback.LiteNetLib.csproj" />
    <ProjectReference Include="..\GameCore\GameCore.csproj" />
    <ProjectReference Include="..\static-rollback\Runtime\Shenanicode.Rollback.csproj" />
  </ItemGroup>
  <!-- The offline navmesh bake (and DotRecast with it) exists only in editor builds, which define TOOLS. -->
  <ItemGroup Condition=" '$(Configuration)' == 'Debug' ">
    <ProjectReference Include="..\NavBuilder\Space.NavBuilder.csproj" />
  </ItemGroup>

  <Target Name="PrintConfig" BeforeTargets="Build">
    <Message Importance="high" Text="ACTUAL CONFIGURATION IS: $(Configuration)" />
  </Target>
</Project>
